{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linguaapp.local/schema/curriculum-level.schema.json",
  "title": "課綱級距檔（一個 CEFR 級距一檔：content/curriculum/<level>.json）",
  "description": "級距 → 主題單元 → 小課。陣列順序即學習順序。小課的 words 是新引入的字（小寫 headword）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "level", "units"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "level": { "enum": ["A1", "A2", "B1", "B2", "C1"] },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/unit" }
    }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "topic", "titleZh", "lessons"],
      "properties": {
        "id": {
          "description": "例：a1-u01；上線後凍結（學習進度引用）",
          "type": "string",
          "pattern": "^(a1|a2|b1|b2|c1)-u[0-9]{2}$"
        },
        "topic": {
          "description": "topics.json 的主題 id",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "titleZh": { "type": "string", "minLength": 1 },
        "lessons": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lesson" }
        }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "words"],
      "properties": {
        "id": {
          "description": "例：a1-u01-l03；上線後凍結",
          "type": "string",
          "pattern": "^(a1|a2|b1|b2|c1)-u[0-9]{2}-l[0-9]{2}$"
        },
        "words": {
          "description": "本課新引入的字（小寫 headword）；字數範圍由 validator 檢查（LESSON_SIZE）",
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
